{
  "manifest_version": 3,
  "name": "Tariff Tracker",
  "version": "1.0",
  "description": "Identifies prices on websites and displays the calculated tariff increases and final prices",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": ["http://localhost:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/new/icon16.png",
      "48": "icons/new/icon48.png",
      "128": "icons/new/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/new/icon16.png",
    "48": "icons/new/icon48.png",
    "128": "icons/new/icon128.png"
  },
  "author": "Pernicious (p3rnicious@mail.com)"
}
